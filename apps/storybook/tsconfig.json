{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@flownamix/react-data-grid-kit": ["../../packages/react-data-grid-kit/src/index.ts"],
      "@flownamix/react-data-grid-kit/headless": ["../../packages/react-data-grid-kit/src/headless.ts"]
    },
    "types": ["vite/client"]
  },
  "include": [".storybook", "src", "../../packages/react-data-grid-kit/src"],
  "exclude": [
    "../../packages/react-data-grid-kit/src/**/*.test.ts",
    "../../packages/react-data-grid-kit/src/**/*.test.tsx"
  ]
}
