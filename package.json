{
  "name": "flownamix-react-data-grid-kit-repo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build": "pnpm --filter @flownamix/react-data-grid-kit build && pnpm storybook:build && pnpm docs:build",
    "build:package": "pnpm --filter @flownamix/react-data-grid-kit build",
    "dev:storybook": "pnpm --filter @flownamix/react-data-grid-kit-storybook storybook",
    "dev:docs": "pnpm --filter @flownamix/react-data-grid-kit-docs docs:dev",
    "storybook:build": "pnpm --filter @flownamix/react-data-grid-kit-storybook build-storybook",
    "docs:build": "pnpm --filter @flownamix/react-data-grid-kit-docs docs:build",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify:package": "pnpm --filter @flownamix/react-data-grid-kit verify:package",
    "version:bump": "node scripts/bump-version.mjs",
    "version:patch": "pnpm version:bump patch",
    "version:minor": "pnpm version:bump minor",
    "version:major": "pnpm version:bump major",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.3.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.7"
  }
}
